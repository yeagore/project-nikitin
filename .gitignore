# Godot 4+ specific ignores
.godot/
/android/

# Godot .NET / C# build output
.mono/
data_*/
bin/
obj/

# Rider / Visual Studio / VS Code
*.user
*.userprefs
.idea/
.vs/

# The documentation's contact sheets are pictures for a reader, not game assets;
# .gdignore keeps the editor from importing them and leaving .import sidecars.
docs/images/*.import
